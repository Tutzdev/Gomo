SPRING_PROFILES_ACTIVE=development
DATABASE_URL=jdbc:postgresql://localhost:5432/prices
DATABASE_USERNAME=prices
DATABASE_PASSWORD=
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_TOKEN_TTL=PT12H
# Cookie de sessão do site. true exige HTTPS (produção); false só para o site local em http.
AUTH_COOKIE_SECURE=false
PRICE_MAX_AGE=P2D
OPENAPI_ENABLED=true
CONTRIBUTION_SOURCE_ID=
ADMIN_BOOTSTRAP_EMAIL=
SUBSCRIBER_BOOTSTRAP_EMAIL=
RECOMMENDATION_MAX_STORES=500
ALERT_REPEAT_INTERVAL=P1D
EMAIL_VERIFICATION_TTL=P1D
PASSWORD_RESET_TTL=PT1H
MAIL_ENABLED=true
MAIL_FROM=no-reply@localhost
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
REGISTRATION_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
ACCOUNT_MESSAGE_RATE_LIMIT=5
CONTRIBUTION_RATE_LIMIT=20
PRICE_COLLECTION_ENABLED=true
PRICE_COLLECTION_CRON=0 30 5 * * *
PRICE_COLLECTION_ZONE=America/Sao_Paulo
PRICE_COLLECTION_COLLECTOR_INTERVAL=PT2S
PRICE_COLLECTION_MINIMUM_RATIO=0.20
PRICE_COLLECTION_MAXIMUM_RATIO=5.00
NAGUMO_COLLECTION_ENABLED=true
NAGUMO_BASE_URL=https://www.nagumo.com.br
NAGUMO_ADDITIONAL_CATEGORY_IDS=acougue,basicos-e-matinais,bazar,bebidas,frios-e-laticinios,hortifruti,limpeza,padaria,peixaria,pet-shop,mercearia-doce,mercearia-salgada,higiene,jardinagem,orientais
NAGUMO_PAGE_SIZE=50
NAGUMO_REQUEST_DELAY=PT1S
NAGUMO_CONNECT_TIMEOUT=PT10S
NAGUMO_REQUEST_TIMEOUT=PT20S
NAGUMO_MAX_ATTEMPTS=2
NAGUMO_MAX_RESPONSE_BYTES=5000000
ROYAL_COLLECTION_ENABLED=true
ROYAL_BASE_URL=https://www.royalsupermercados.com.br
ROYAL_API_URL=https://services.vipcommerce.com.br
ROYAL_PUBLIC_CONFIGURATION_PATH=/chunk-TLHOSSIT.js
ROYAL_SEARCH_TERMS=coca,italac,bauducco,yoki,coracoes
ROYAL_FULL_CATALOG=true
ROYAL_CONNECT_TIMEOUT=PT10S
ROYAL_REQUEST_TIMEOUT=PT20S
ROYAL_REQUEST_DELAY=PT1S
ROYAL_MAX_ATTEMPTS=2
ROYAL_MAX_RESPONSE_BYTES=5000000
APP_COLLECTION_REGIONAL_ENABLED=true
# Optional local archive; replay preserves the original collection timestamp.
APP_COLLECTION_ARCHIVE_DIRECTORY=.local/catalog-snapshots
# Optional operator batch, omitted during normal startup:
# APP_COLLECTION_RUN_ON_START=hortifruti_aterrado,bramil_santo_agostinho
# Premium pago pela AbacatePay (API v2). Passo a passo em docs/operations.md, seção 6.
ABACATEPAY_ENABLED=false
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_MONTHLY_PRODUCT_ID=
ABACATEPAY_ANNUAL_PRODUCT_ID=
ABACATEPAY_SITE_URL=https://seu-dominio.com.br
# true com a chave de Dev mode; false com a chave de produção.
ABACATEPAY_DEV_MODE=true
# CARD (padrão da AbacatePay para assinaturas) ou CARD,PIX.
ABACATEPAY_METHODS=CARD
# Erros do backend no Sentry. Vazio ou ausente: o Sentry não é carregado.
# SENTRY_DSN=https://<chave>@o<org>.ingest.sentry.io/<projeto>
# SENTRY_ENVIRONMENT=production
