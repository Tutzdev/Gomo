VITE_API_BASE_URL=http://localhost:8080/api/v1
# Endereço público do site, sem barra no fim. Sem ele, a prévia de link do WhatsApp sai sem imagem.
# VITE_SITE_URL=https://seu-dominio.com.br

# Medição, toda desligada por padrão: sem estas variáveis no build nenhum script de terceiros é carregado.
# Analytics sem cookie (Plausible ou Umami). As três precisam estar preenchidas.
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_SITE_ID=
# Erros do site no Sentry (DSN do projeto JavaScript).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
